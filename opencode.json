{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless=true",
        "--isolated=true",
        "--usageStatistics=false",
        "--executablePath=C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe"
      ],
      "enabled": true
    }
  }
}