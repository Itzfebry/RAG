{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/warmup",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "api/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,.next/**,data/**,docs/**,public/**,components/**,app/**,e2e/**,playwright-report/**,test-results/**,**/__pycache__/**,**/*.pyc,**/*.map,*.md}"
    }
  }
}
