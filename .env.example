# Model / Provider Configuration (generic — any OpenAI-compatible provider)
# Canonical vars. GEMINI_* kept as legacy aliases for old .env files.
OPENROUTER_API_KEY=your-openrouter-api-key
ACTIVE_MODEL=qwen/qwen3.8-27b:free
API_BASE_URL=https://openrouter.ai/api/v1
MODEL_PROVIDER=openrouter
GEMINI_API_KEY=
GEMINI_MODEL=

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=... # bcrypt hash of admin password
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production

# App Config
PORT=8000
NODE_ENV=development
