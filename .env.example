# Model / Provider Configuration (generic — any OpenAI-compatible provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
ACTIVE_MODEL=qwen/qwen3.8-27b:free
API_BASE_URL=https://openrouter.ai/api/v1
MODEL_PROVIDER=openrouter
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
NVIDIA_API_KEY=
NVIDIA_MODEL=poolside/laguna-xs-2.1
NINE_ROUTER_API_KEY=

# Embedding (knowledge base). EMBEDDING_DIM harus sama dengan kolom vector di Supabase (768).
# Provider produksi = gemini (gemini-embedding-2, 768 dim). Ganti provider = wajib reindex.
EMBEDDING_PROVIDER=gemini
EMBEDDING_DIM=768
MATCH_THRESHOLD=0.64
# Dipakai hanya kalau EMBEDDING_PROVIDER=hf (MiniLM 384 dim - butuh reindex).
HF_TOKEN=
HF_EMBEDDING_RETRIES=4
HF_EMBEDDING_RETRY_WAIT=3.0
HF_EMBEDDING_TIMEOUT=30.0
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH_OF_YOUR_PASSWORD
JWT_SECRET_KEY=generate_new_secret_key_here

# Wajib: nilai acak min 32 karakter. Backend gagal start jika kosong/default.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Cron warmup (Vercel mengirim Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate_random_cron_secret_here

# CORS origin tambahan (regex). Default: https://itzfebry\.vercel\.app
# CORS_ORIGIN_REGEX=

# App Config
PORT=8000
NODE_ENV=development
# 0 = matikan auto-reload uvicorn (lebih stabil saat dipakai chat)
UVICORN_RELOAD=1

# Google OAuth (login user via Google) — opsional
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/python/auth/google-callback

# Email OTP (verifikasi email & reset kata sandi). Isi salah satu: SMTP atau Resend.
# Tanpa provider di production, kirim OTP gagal dan user baru tertahan gate verifikasi.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
RESEND_API_KEY=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
